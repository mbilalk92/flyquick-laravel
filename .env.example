APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google reCAPTCHA v3 ───────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SKIP_IP=

# ── Analytics / tracking (config/analytics.php) ───────
# Carried over from the old WordPress site to preserve historical data.
GA4_MEASUREMENT_ID=G-YJEFT3E15V
META_PIXEL_ID=630818262248052
# Old site had no GTM container — leave blank unless one is set up later.
GTM_CONTAINER_ID=
# Old site never completed Search Console verification — fill in once you
# generate an HTML tag verification code in Search Console (the content
# value only, not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=

# ── Site-wide contact details (config/site.php) ───────
# Read by the hero, trust row, footer and contact sections.
SITE_URL="${APP_URL}"
SITE_PHONE="+61 3 9017 1800"
SITE_PHONE_HREF=tel:+61390171800
SITE_EMAIL=support@flyquick.com.au
SITE_WHATSAPP="https://wa.me/61390171800?text=Hi%20Fly%20Quick%2C%20I%27d%20like%20help%20planning%20a%20trip."
SITE_HOURS="Mon–Sat 9am–11pm · Sun 11am–7pm, Melbourne time"
BLOG_URL="http://flyquick-static.test/blog"

# ── WordPress blog DB (read-only, for blog-preview sections) ─
# Separate WordPress install — see config/database.php 'blog' connection
# and app/Services/BlogService.php. Must match the WP install's table prefix.
BLOG_DB_HOST=127.0.0.1
BLOG_DB_PORT=3306
BLOG_DB_DATABASE=flyquick-static-blog
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=
BLOG_DB_PREFIX=fly_

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
